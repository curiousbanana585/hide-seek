{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".write": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        "state": {
          ".validate": "newData.hasChildren(['v', 'state'])"
        },
        "hb": {
          ".validate": "newData.isNumber()"
        },
        "cmds": {
          "$id": {
            ".validate": "newData.hasChildren(['v', 't'])"
          }
        },
        "t": {
          "$dev": {
            ".validate": "newData.isNumber()"
          }
        },
        "draft": {
          ".validate": "newData.hasChildren(['v', 'run'])"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tins": {
      "$code": {
        ".read": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".write": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        "game": {
          ".validate": "newData.hasChildren(['v', 'host'])"
        },
        "players": {
          "$p": {
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 16"
          }
        },
        "pres": {
          "$p": {
            ".validate": "newData.hasChildren(['t'])"
          }
        },
        "rounds": {
          "$n": {
            ".validate": "$n.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['sardine', 'word', 'startAt'])",
            "taunt": {
              "$id": {
                ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 80"
              }
            }
          }
        },
        "clk": {
          "$dev": {
            ".validate": "newData.isNumber()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}